{
  "name": "cooplevel",
  "version": "2.0.0",
  "description": "CoopLevel — a modern slash-command Discord leveling and XP bot.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js --global",
