    "check:commands": "node deploy-commands.js --check",
    "dev": "node index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "levels",
    "xp",
    "cooplevel"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.5"
  }
}
